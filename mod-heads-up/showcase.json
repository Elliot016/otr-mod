          { "spans": [{ "text": "▎", "color": "accent", "bg": "surface1" }, { "text": "\ue0b6", "color": "#2f3656", "bg": "surface1" }, { "text": "Heads up", "color": "accent", "bg": "#2f3656", "bold": true }, { "text": "\ue0b4", "color": "#2f3656", "bg": "surface1" }, { "text": " " }, { "text": "The main agent cached /ask, so one-off", "color": "onSurface" }] },
          { "spans": [{ "text": "▎", "color": "accent", "bg": "surface1" }, { "text": " ", "bg": "surface1" }, { "text": "        ", "bg": "#2f3656" }, { "text": " ", "bg": "surface1" }, { "text": " " }, { "text": "questions cost more.", "color": "onSurface" }] },
          { "spans": [{ "text": "▎", "color": "accent", "bg": "surface1" }, { "text": "\ue0b6", "color": "surface3", "bg": "surface1" }, { "text": "\ue0b6", "color": "#3b446a", "bg": "surface3" }, { "text": "\uf054", "color": "accent", "bg": "#3b446a", "bold": true }, { "text": "\ue0b4", "color": "#3b446a", "bg": "surface3" }, { "text": " Open ", "color": "onSurface", "bg": "surface3" }, { "text": "\ue0b4", "color": "surface3", "bg": "surface1" }, { "text": " " }, { "text": "\ue0b6", "color": "surface3", "bg": "surface1" }, { "text": " \uf00d ", "color": "onSurface", "bg": "surface3" }, { "text": "\ue0b4", "color": "surface3", "bg": "surface1" }] }
        ],
