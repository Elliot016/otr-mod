{
  "tagline": "One thing worth knowing, only when it matters",
  "features": [
    { "title": "A side check", "detail": "Every sixth step of a long turn, at most once per turn, a check reads the session and flags one thing you should understand and probably missed. Most checks show nothing." },
    { "title": "A card above the prompt", "detail": "The note shows with its tag, You should know or Heads up, and says who decided. Open shows it in the panel, × dismisses it." },
    { "title": "The Heads up panel", "detail": "Every note of the session under its turn, opened in place, with Got it, Ask Claude and Reword (simpler words, less detail or more detail). Hover any control for what it does." }
  ],
  "actions": [
    { "label": "Close the heads-up card", "command": "mod-heads-up", "args": "clear" },
    { "label": "Forget the topics marked as known", "command": "mod-heads-up", "args": "forget" }
  ],
  "previews": {
    "enabled": {
      "true": {
        "frame": { "border": "accent", "bg": "surface1" },
