{
  "tagline": "A folded transcript: one line per turn, one line per tool call",
  "features": [
    { "title": "Turn line", "detail": "Under each prompt, a line names what the turn did: tool count, file changes with lines added and removed, skills, agents and time." },
    { "title": "Tool lines", "detail": "Inside an open turn, each finished tool call is one line; a click shows its full row and diff." },
    { "title": "Card", "detail": "An open turn draws as one tinted card with a bar down its left edge; the final reply stays outside it." }
  ],
  "actions": [
    { "label": "Fold or unfold every turn", "command": "mod-turn-fold" },
    { "label": "Write the drawn row ids to %TEMP%", "command": "mod-turn-fold", "args": "debug" }
  ],
  "previews": {
    "fold_turns": {
      "true": [
        { "spans": [{ "text": "❯ fix the bug", "color": "onSurface" }] },
        { "bar": "border", "spans": [{ "text": "+", "color": "onSurface", "bg": "accent", "pill": true }, { "text": " Edit(hooks/a.ts) ", "color": "onSurface" }, { "text": "", "pill": true, "parts": [{ "text": "+2", "color": "good" }, { "text": " " }, { "text": "−1", "color": "alert" }] }, { "text": " " }, { "text": "1m 4s", "color": "muted", "pill": true }] },
        { "spans": [{ "text": "● Fixed.", "color": "onSurface" }] }
      ],
      "false": [
        { "spans": [{ "text": "❯ fix the bug", "color": "onSurface" }] },
        { "bar": "accent", "spans": [{ "text": "−", "color": "onSurface", "bg": "accent", "pill": true }, { "text": " Edit(hooks/a.ts) ", "color": "onSurface" }, { "text": "", "pill": true, "parts": [{ "text": "+2", "color": "good" }, { "text": " " }, { "text": "−1", "color": "alert" }] }, { "text": " " }, { "text": "1m 4s", "color": "muted", "pill": true }] },
        { "bar": "accent", "spans": [{ "text": "Thought", "color": "onSurface", "bg": "lifted", "pill": true }, { "text": " " }, { "text": "Edited 1", "color": "muted", "pill": true }, { "text": " " }, { "text": "Ran 1", "color": "muted", "pill": true }] },
        { "spans": [{ "text": "● Fixed.", "color": "onSurface" }] }
      ]
    },
    "fold_tools": {
      "true": [
        { "bar": "accent", "spans": [{ "text": "+", "bg": "border", "pill": true }, { "text": " Edit(hooks/a.ts) ", "color": "muted" }, { "text": "", "pill": true, "parts": [{ "text": "+2", "color": "good" }, { "text": " " }, { "text": "−1", "color": "alert" }] }] }
      ],
      "false": [
        { "bar": "accent", "spans": [{ "text": "● Edit(hooks/a.ts)" }] },
        { "bar": "accent", "spans": [{ "text": "  ⎿ Added 2 lines, removed 1 line", "color": "muted" }] },
        { "bar": "accent", "spans": [{ "text": "    - old", "color": "alert" }] },
        { "bar": "accent", "spans": [{ "text": "    + new", "color": "good" }] },
        { "bar": "accent", "spans": [{ "text": "    + added", "color": "good" }] }
      ]
    }
  }
}
